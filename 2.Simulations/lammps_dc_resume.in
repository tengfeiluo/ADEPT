# ADEPT dielectric constant, resumable. Same physics as lammps_dc.in, run in checkpointable chunks.
# Vars (set by run_dc_resumable): name resume(0/1) rstfile run_upto step0 incdir rstprefix
# The dipole record of each chunk goes to its own part file (first column = step); the wrapper merges them.
log             ${name}_dc.log append
if "${resume} == 0" then "include ${incdir}/dc_fresh_read.inc" else "read_restart ${rstfile}"
# Remove center-of-mass drift: nothing else in this run conserves or resets linear momentum,
# and the drift builds up to tens of m/s over nanoseconds (it also biases the temperature).
velocity        all zero linear
fix             MOMZERO all momentum 1000 linear 1 1 1
kspace_style    pppm 1e-6
timestep        1.0
neighbor        2.5 bin
neigh_modify    delay 0 every 1 check yes
fix             SHAKE2 all shake 1e-4 1000 0 m 1.0
fix             1 all nvt temp 300.0 300.0 100.0
compute         myDipole1 all dipole
variable        dipole1 equal c_myDipole1[1]
variable        dipole2 equal c_myDipole1[2]
variable        dipole3 equal c_myDipole1[3]
variable        dipole4 equal c_myDipole1
variable        volume equal vol
variable        st equal step
fix             dipolePrint all print 1000 "${st} ${dipole1} ${dipole2} ${dipole3} ${dipole4} ${volume} " file ${name}_dipole_fluctuation.dat.part_${step0} screen no
thermo_style    custom step temp press density vol
thermo          1000
run             ${run_upto} upto
include         ${incdir}/stage_write_rst.inc
