# ADEPT eq2, resumable (2026-10-24). Same physics as lammps_eq2.in, split into checkpointable chunks.
# Timeline (timestep counter, 1 fs steps after the 0.1 fs start-up, which is followed by reset_timestep 0):
#   ramp : step 0 .. ramp_steps            NPT 1000 -> 300 K (start/stop keep the ramp continuous across chunks)
#   hold : step ramp_steps .. total_steps   NPT 300 K, density + Rg recorded
# Vars (set by run_eq2_resumable): seg name resume(0/1) rstfile phase(1 ramp, 2 hold) run_upto ramp_steps total_steps incdir
log             ${name}_eq2.log append
if "${resume} == 0" then "include ${incdir}/eq2_fresh_read.inc" else "read_restart ${rstfile}"
# Remove center-of-mass drift: nothing else in this run conserves or resets linear momentum,
# and the drift builds up to tens of m/s over nanoseconds (it also biases the temperature).
velocity        all zero linear
fix             MOMZERO all momentum 1000 linear 1 1 1
neighbor        3.0 bin
neigh_modify    delay 0 every 1 check yes
kspace_style    pppm 1e-4
thermo          1000
thermo_style    custom step temp press etotal ke pe ebond eangle edihed eimp evdwl ecoul elong vol density lx ly lz
thermo_modify   flush yes
if "${resume} == 0" then "include ${incdir}/eq2_fresh_startup.inc"
timestep        1.0
fix             SHAKE2 all shake 1e-4 1000 0 m 1.0
if "${phase} == 1" then "fix NPTs all npt temp 1000 300 100.0 iso 1.0 1.0 1000.0" else "include ${incdir}/eq2_hold_setup.inc"
# 100 ps segments: each run re-initialises the PPPM grid for the current box
label           seg
if "$(step) >= ${run_upto}" then "jump SELF segdone"
if "${phase} == 1" then "run ${seg} start 0 stop ${ramp_steps}" else "run ${seg}"
jump            SELF seg
label           segdone
write_restart   ${name}_eq2_end.rst
print           "$(step)" file ${name}_eq2_progress.dat
if "$(step) >= ${total_steps}" then "write_data ${name}_eq2.data"
